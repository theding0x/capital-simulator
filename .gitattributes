# Default: treat as text and normalize to LF in the repository.
# Each working tree may use its native EOL on checkout.
* text=auto eol=lf

# Binary asset types — never normalize.
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.svg  binary
*.woff  binary
*.woff2 binary
*.ttf binary
*.eot binary
*.otf binary
*.pdf binary
