package store

import (
	"context"
	"sort"
	"strings"
	"sync"
	"time"

	"github.com/theding0x/capital-simulator/services/<<svc>>/internal/<<pkg>>"
)

// Memory is an in-memory Store. Used by unit tests and as a fallback when
// MongoDB is unavailable in local development.
type Memory struct {
	mu    sync.RWMutex
	items map[<<pkg>>.ID]<<pkg>>.<<Type>>
	now   func() time.Time
}

// NewMemory returns an empty Memory store.
func NewMemory() *Memory {
	return &Memory{
		items: make(map[<<pkg>>.ID]<<pkg>>.<<Type>>),
		now:   time.Now,
	}
}

// Create inserts x. <<key>> is treated as a uniqueness key (case-insensitive
// after trimming) so the simulation has one canonical record per <<type>>.
func (m *Memory) Create(_ context.Context, x <<pkg>>.<<Type>>) (<<pkg>>.<<Type>>, error) {
	if err := x.Validate(); err != nil {
		return <<pkg>>.<<Type>>{}, err
	}
	m.mu.Lock()
	defer m.mu.Unlock()

	wantKey := normalizeKey(x.<<key>>)
	for _, existing := range m.items {
		if normalizeKey(existing.<<key>>) == wantKey {
			return <<pkg>>.<<Type>>{}, ErrAlreadyExists
		}
	}

	if x.ID.IsZero() {
		x.ID = <<pkg>>.NewID()
	}
	now := m.now()
	x.CreatedAt = now
	x.UpdatedAt = now
	m.items[x.ID] = x
	return x, nil
}

func (m *Memory) Get(_ context.Context, id <<pkg>>.ID) (<<pkg>>.<<Type>>, error) {
	m.mu.RLock()
	defer m.mu.RUnlock()
	x, ok := m.items[id]
	if !ok {
		return <<pkg>>.<<Type>>{}, ErrNotFound
	}
	return x, nil
}

func (m *Memory) List(_ context.Context) ([]<<pkg>>.<<Type>>, error) {
	m.mu.RLock()
	defer m.mu.RUnlock()
	out := make([]<<pkg>>.<<Type>>, 0, len(m.items))
	for _, x := range m.items {
		out = append(out, x)
	}
	sort.Slice(out, func(i, j int) bool {
		return strings.ToLower(out[i].<<key>>) < strings.ToLower(out[j].<<key>>)
	})
	return out, nil
}

func (m *Memory) Update(_ context.Context, id <<pkg>>.ID, u Update) (<<pkg>>.<<Type>>, error) {
	m.mu.Lock()
	defer m.mu.Unlock()
	cur, ok := m.items[id]
	if !ok {
		return <<pkg>>.<<Type>>{}, ErrNotFound
	}
	next := u.Apply(cur)
	if err := next.Validate(); err != nil {
		return <<pkg>>.<<Type>>{}, err
	}
	// Key uniqueness is preserved on rename. <<KeyUpdateField>> below should
	// be the *string field on Update that maps to <<key>>.
	if u.<<KeyUpdateField>> != nil && !strings.EqualFold(*u.<<KeyUpdateField>>, cur.<<key>>) {
		want := normalizeKey(*u.<<KeyUpdateField>>)
		for otherID, other := range m.items {
			if otherID == id {
				continue
			}
			if normalizeKey(other.<<key>>) == want {
				return <<pkg>>.<<Type>>{}, ErrAlreadyExists
			}
		}
	}
	next.UpdatedAt = m.now()
	m.items[id] = next
	return next, nil
}

func (m *Memory) Delete(_ context.Context, id <<pkg>>.ID) error {
	m.mu.Lock()
	defer m.mu.Unlock()
	if _, ok := m.items[id]; !ok {
		return ErrNotFound
	}
	delete(m.items, id)
	return nil
}

func normalizeKey(s string) string { return strings.ToLower(strings.TrimSpace(s)) }
